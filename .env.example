# ════════════════════════════════════════
# ТворцыДобра — Environment Variables Template
# ════════════════════════════════════════
# Copy this file to backend/.env and frontend/.env.local
# Then fill in the values from your respective services

├── # FRONTEND ENVIRONMENT VARIABLES (.env.local)
│   ├── NEXT_PUBLIC_API_URL=http://localhost:3001/api
│   │   └── Backend API endpoint (change for production)
│   │
├── # Payment Gateway Keys (Publishable Only)
│   ├── NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
│   │   └── Stripe Publishable Key - NEVER expose secret key here
│   │
├── NEXT_PUBLIC_PAYPAL_CLIENT_ID=AaB12YourClientIdHere
│   └── PayPal Client ID for sandbox mode
│
├── # Branding & Metadata
│   ├── NEXT_PUBLIC_SITE_NAME=ТворцыДобра
│   ├── NEXT_PUBLIC_SITE_URL=http://localhost:3000
│   │   └── Will become https://tvorcydobra.ru in production
│   │
├── NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
│   └── Optional analytics tracking ID
│
└── # BACKEND ENVIRONMENT VARIABLES (backend/.env)
    ├── # Database Configuration (PostgreSQL 15+)
    ├── DB_HOST=localhost
    ├── DB_PORT=5432
    ├── DB_USERNAME=postgres
    ├── DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_123!
    ├── DB_NAME=tvorcy_dobra
    │
    ├── # JWT Authentication
    ├── JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-long-here
    ├── JWT_REFRESH_SECRET=another-secret-for-refresh-tokens-too-long
    ├── JWT_EXPIRATION=7d  │   │   └── Access token lifetime
    ├── JWT_REFRESH_EXPIRATION=30d │   └── Refresh token lifetime
    │
    ├── # Payment Gateways (Secret Keys!)
    ├── STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
    ├── STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
    │
    ├── PAYPAL_CLIENT_ID=AaB12YourPayPalClientIdHere
    ├── PAYPAL_CLIENT_SECRET=YourPayPalClientSecretHere
    ├── PAYPAL_MODE=sandbox  │   └── Change to 'live' in production
    │
    ├── YUKASSA_STORE_ID=your_yukassa_store_id
    ├── YUKASSA_SIGNATURE=your_yukassa_signature_key
    ├── YUKASSA_WORKFLOW_URL=https://yookassa.ru/api
    │
    └── # Application Settings
        ├── CORS_ORIGINS=http://localhost:3000,http://localhost:3001
        ├── NODE_ENV=development  │   └── Set to 'production' on deploy
        ├── PORT=3001
        ├── LOG_LEVEL=debug  │   └── Reduce to 'info' or 'warn' for production
